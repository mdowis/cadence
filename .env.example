# Cadence configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Kalshi API credentials (required for live trading) ---
#
# Kalshi uses RSA-PSS signed requests. When you create an API key pair at
# https://kalshi.com/account/api-keys, Kalshi gives you:
#   1. An API key ID (short string)
#   2. A private key PEM file (downloaded once - keep it safe!)
#
# Put the PEM file somewhere on your machine and reference its path below.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/path/to/your/kalshi_private_key.pem

# Alternative: email/password login (gets a 24h JWT, less preferred)
# KALSHI_EMAIL=
# KALSHI_PASSWORD=

# --- Risk management (all values in cents) ---
# Starting equity in cents. If CADENCE_SYNC_BALANCE=true, this is overridden
# by your actual Kalshi cash balance on startup.
CADENCE_EQUITY=5000

# Automatically sync equity from Kalshi on every scan.
CADENCE_SYNC_BALANCE=true

# Kill switch: halt all trading at this % drawdown from peak
CADENCE_MAX_DRAWDOWN_PCT=10

# Max loss per calendar day in cents
CADENCE_DAILY_LOSS_LIMIT=2000

# Max cost per single arbitrage trade in cents
CADENCE_MAX_PER_TRADE=500

# Max total exposure across all open positions in cents
CADENCE_MAX_EXPOSURE=10000

# Pause trading after N consecutive losses
CADENCE_MAX_CONSECUTIVE_LOSSES=5

# Minimum net profit in cents for a trade to execute
CADENCE_MIN_PROFIT=2

# --- Scanner / Executor ---
# Contracts per leg when auto-executing
CADENCE_CONTRACTS=1

# Seconds between scans
CADENCE_INTERVAL=15

# --- Dashboard ---
CADENCE_PORT=8050

# Persist risk state across restarts
CADENCE_STATE_FILE=risk_state.json
